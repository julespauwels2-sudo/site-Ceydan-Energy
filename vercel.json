{
  "cleanUrls": true,
  "headers": [
    { "source": "/(style\\.css|app\\.js|anim\\.js|icones\\.js)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/(config\\.js|data\\.js|partenaires\\.js)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] },
    { "source": "/(.*)\\.(webp|png|jpg|svg)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }] }
  ]
}
